    {
      "name": "contains-array-by-deep-equality",
      "expr": "(contains? (arr (arr 1) (arr 2)) (arr 2))",
      "expect": {
        "bool": true
      },
      "note": "contains? serves arrays too, by deep equality rather than identity.",
      "spec": "\u00a77.5"
    },
    {
      "name": "contains-array-false",
      "expr": "(contains? (arr 1 2) 3)",
      "expect": {
        "bool": false
      },
      "spec": "\u00a77.5"
    },
    {
      "name": "contains-array-compares-numbers-by-value-across-int-and-float",
      "expr": "(contains? (arr 1) 1.0)",
      "expect": {
        "bool": true
      },
      "note": "contains? uses \u00a74.2 deep equality, and \u00a74.2 compares numbers by mathematical value across int and float -- so an array of ints contains 1.0. \u00a74.2's \"exact rather than by conversion\" rule is about precision above 2^53, not about int and float being distinct for equality. The counter-intuitive direction is why this vector exists.",
      "spec": "\u00a77.5, \u00a74.2"
    },
    {
      "name": "contains-array-is-exact-above-2-53",
      "expr": "(contains? (arr 9007199254740993) 9007199254740992.0)",
      "expect": {
        "bool": false
      },
      "spec": "\u00a77.5, \u00a74.2",
      "note": "The other half of the rule: equality is by mathematical value but computed exactly, so above 2^53 the int and the float are different numbers. A host comparing by conversion would answer true here and agree everywhere below -- the silent divergence \u00a711 exists to catch."
    }
  ]
}
