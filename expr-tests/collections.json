      "spec": "\u00a77.8"
    },
    {
      "name": "get-or-does-not-rescue-a-wrong-key-kind",
      "expr": "(get-or (arr 10) \"a\" 0)",
      "error": "TYPE",
      "note": "get-or substitutes for absence only. A key of a kind the container could never hold is still TYPE: it is not absent, it was never a key that container has.",
      "spec": "\u00a77.8"
    },
    {
