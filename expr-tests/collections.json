          "b": {
            "int": 1
          }
        }
      },
      "spec": "\u00a77.5, \u00a72"
    },
    {
      "name": "dict-odd-arity-is-an-error",
      "expr": "(dict \"a\")",
      "error": "ANY",
      "note": "dict takes alternating keys and values, so an even count. Pure arity, so 10 decides it at configure time from the table rather than per signal.",
      "spec": "\u00a77.5"
    },
    {
      "name": "dict-non-string-key-is-an-error",
      "expr": "(dict 1 2)",
      "error": "TYPE",
      "note": "Keys MUST be strings.",
      "spec": "\u00a77.5"
    },
    {
      "name": "dict-duplicate-key-is-an-error",
      "expr": "(dict \"a\" 1 \"a\" 2)",
      "error": "DOMAIN",
      "note": "Not last-wins: keys are written out one by one, so a repeat is a typo, and keeping one of the two values silently is how it reaches production.",
      "spec": "\u00a77.8"
    },
    {
      "name": "get-from-a-map",
      "expr": "(get (dict \"a\" 1) \"a\")",
      "expect": {
        "int": 1
      },
      "spec": "\u00a77.5"
    },
    {
      "name": "get-missing-map-key-is-an-error",
      "expr": "(get (dict \"a\" 1) \"b\")",
      "error": "MISSING",
      "spec": "\u00a77.5"
    },
    {
      "name": "get-from-an-array-by-index",
      "expr": "(get (arr 10 20) 1)",
      "expect": {
        "int": 20
      },
      "spec": "\u00a77.5"
    },
    {
      "name": "get-array-index-out-of-range-is-an-error",
      "expr": "(get (arr 10) 5)",
      "error": "MISSING",
      "spec": "\u00a77.5"
    },
    {
      "name": "get-negative-array-index-is-absent-not-ill-typed",
      "expr": "(get (arr 10) -1)",
      "error": "MISSING",
      "note": "It is an integer, which is the right *kind* of key for an array, and there is no from-the-end indexing in v1 -- so it is absent, not ill-typed.",
      "spec": "\u00a77.8"
    },
    {
      "name": "get-with-a-wrong-kind-of-key-is-ill-typed",
      "expr": "(get (arr 10) \"a\")",
      "error": "TYPE",
      "spec": "\u00a77.8"
    },
    {
      "name": "get-or-substitutes-for-a-missing-key",
