{
  "vectors": [
    {
      "name": "arr-empty-is-the-only-empty-array-syntax",
      "expr": "(arr)",
      "expect": {
        "arr": []
      },
      "note": "\u00a73.2 gives no literal syntax for an array, so the zero-argument variadic is how an empty one is written.",
      "spec": "\u00a77"
    },
    {
      "name": "arr-of-mixed-values",
      "expr": "(arr 1 \"a\" true null 1.5)",
      "expect": {
        "arr": [
          {
            "int": 1
          },
          {
            "str": "a"
          },
          {
            "bool": true
          },
          {
            "null": null
          },
          {
            "float": 1.5
          }
        ]
      },
      "spec": "\u00a77.5"
    },
    {
      "name": "arr-nested",
      "expr": "(arr (arr 1) (arr))",
      "expect": {
        "arr": [
          {
            "arr": [
              {
                "int": 1
              }
            ]
          },
          {
            "arr": []
          }
        ]
      },
      "spec": "\u00a77.5"
    },
    {
      "name": "dict-empty-is-the-only-empty-map-syntax",
      "expr": "(dict)",
      "expect": {
        "map": {}
      },
      "spec": "\u00a77"
    },
    {
      "name": "dict-pairs",
      "expr": "(dict \"a\" 1 \"b\" 2)",
      "expect": {
        "map": {
          "a": {
            "int": 1
          },
          "b": {
            "int": 2
          }
        }
      },
      "spec": "\u00a77.5"
    },
    {
      "name": "dict-orders-by-key",
      "expr": "(dict \"b\" 1 \"a\" 2)",
      "expect": {
