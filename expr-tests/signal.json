{
  "vectors": [
    {
      "name": "signal-whole-signal-is-a-map",
      "expr": "(map? $)",
      "signal": {
        "temp": {
          "float": 21.5
        },
        "name": {
          "str": "probe"
        },
        "nested": {
          "map": {
            "a": {
              "map": {
                "b": {
                  "int": 7
                }
              }
            }
          }
        },
        "count": {
          "int": 3
        }
      },
      "expect": {
        "bool": true
      },
      "spec": "\u00a76"
    },
    {
      "name": "signal-attribute-sugar",
      "expr": "$temp",
      "signal": {
        "temp": {
          "float": 21.5
        },
        "name": {
          "str": "probe"
        },
        "nested": {
          "map": {
            "a": {
              "map": {
                "b": {
                  "int": 7
                }
              }
            }
          }
        },
        "count": {
          "int": 3
        }
      },
      "expect": {
        "float": 21.5
      },
      "spec": "\u00a76"
    },
    {
      "name": "signal-sugar-equals-explicit-get",
      "expr": "(= $temp (get $ \"temp\"))",
      "signal": {
        "temp": {
          "float": 21.5
        },
        "name": {
          "str": "probe"
        },
        "nested": {
          "map": {
            "a": {
              "map": {
                "b": {
                  "int": 7
                }
              }
            }
          }
        },
        "count": {
          "int": 3
        }
      },
      "expect": {
        "bool": true
      },
      "note": "$name is reader sugar for (get $ \"name\"), single-level.",
      "spec": "\u00a76"
    },
    {
      "name": "signal-nested-access-is-explicit",
      "expr": "(get-in $ (arr \"nested\" \"a\" \"b\"))",
      "signal": {
        "temp": {
          "float": 21.5
        },
        "name": {
          "str": "probe"
        },
        "nested": {
          "map": {
            "a": {
              "map": {
                "b": {
                  "int": 7
                }
              }
            }
          }
        },
        "count": {
          "int": 3
        }
      },
      "expect": {
        "int": 7
      },
      "note": "There is no $a.b: nested access is spelled out, so the sugar stays single-level and unambiguous.",
      "spec": "\u00a76"
    },
    {
      "name": "signal-missing-attribute-is-an-error",
      "expr": "$humidity",
      "signal": {
        "temp": {
          "float": 21.5
        },
        "name": {
          "str": "probe"
        },
        "nested": {
          "map": {
            "a": {
              "map": {
                "b": {
                  "int": 7
                }
              }
            }
          }
        },
        "count": {
          "int": 3
        }
      },
      "error": "MISSING",
      "note": "Missing data is an error, not null. Silent null converts config typos into downstream mysteries.",
      "spec": "\u00a76"
    },
    {
      "name": "signal-missing-handled-with-get-or",
      "expr": "(get-or $ \"humidity\" 0)",
      "signal": {
        "temp": {
          "float": 21.5
        },
        "name": {
          "str": "probe"
        },
        "nested": {
          "map": {
            "a": {
              "map": {
                "b": {
                  "int": 7
                }
              }
            }
          }
        },
        "count": {
          "int": 3
        }
      },
      "expect": {
        "int": 0
      },
      "note": "Graceful handling is explicit, which is the point: the reader sees the default.",
      "spec": "\u00a76"
    },
